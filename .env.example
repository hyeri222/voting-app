# Copy to .env.local (and set the same keys in Vercel's environment variables).
# Neon connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# The single 운영자's login 비밀번호.
ADMIN_PASSWORD=change-me
# Signs the 운영자 session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs the 운영자 out everywhere.
SESSION_SECRET=
